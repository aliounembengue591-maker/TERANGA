{
  "hosting": [
    {
      "site": "teranga-beauty-luxe",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "site": "gen-lang-client-0777029768",
      "redirects": [
        {
          "source": "/**",
          "destination": "https://teranga-beauty-luxe.web.app/:splat",
          "type": 301
        }
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  }
}
